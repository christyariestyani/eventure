{
  "name": "eventure",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "android": "npm run dev --workspace=@eventure/mobile -- --android",
    "start:mobile": "expo start --project-root apps/mobile"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "npm@10.5.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
